VITE_APP_ENV=development
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
VITE_AUTH_REDIRECT_URL=https://seu-dominio.com

# Jira Cloud: server-side only; never prefix secrets with VITE_.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Jira Data Center: server-side PAT configuration for the Timesheet deploy mode.
JIRA_DC_BASE_URL=https://agile.corp.edp.pt
JIRA_DC_PAT=
# Extra exact HTTPS base URLs, comma-separated. Corporate EDP URL is allowed by default.
JIRA_DC_ALLOWED_BASE_URLS=
JIRA_TIMEZONE=America/Fortaleza
# Comma-separated Supabase user UUIDs authorized to use the deploy credentials.
JIRA_DEPLOY_ALLOWED_USER_IDS=
